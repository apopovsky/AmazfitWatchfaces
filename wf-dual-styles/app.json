{
  "configVersion": "v3",
  "app": {
    "appId": 1199001,
    "appName": "TR3X Dash",
    "appType": "watchface",
    "version": {
      "code": 3,
      "name": "1.2.0"
    },
    "icon": "icon.png",
    "vender": "apopo",
    "description": "Custom tactical dashboard watchface for Amazfit T-Rex 3 Pro 48mm with optically centered time, switchable dual-arc / battery-pill layouts, customizable accent colors, HRV, RHR, BioCharge, PAI, weather, and live HR trend."
  },
  "permissions": [
    "data:user.hd.pai",
    "data:user.hd.heart_rate",
    "data:user.hd.calorie",
    "data:user.hd.step"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.6.0",
      "target": "3.6.0",
      "minVersion": "3.6"
    },
    "type": 2
  },
  "targets": {
    "rocky": {
      "module": {
        "watchface": {
