          "main": 1,
          "editable": 1,
          "lockscreen": 1
        }
      },
      "platforms": [
        {
          "name": "Rocky",
          "deviceSource": 10551552
        },
        {
          "name": "RockyWN",
          "deviceSource": 10551553
        },
        {
          "name": "RockyW",
          "deviceSource": 10551555
        }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": {
      "appName": "TR3X Dash"
    },
    "es-ES": {
      "appName": "TR3X Dash"
    }
  },
  "defaultLanguage": "es-ES"
}
